# Explicit deterministic demo. Choose live for genuine provider operations.
IRIS_MODE=demo
IRIS_ENV=development
# Development uses a persistent random key outside Git.
# Production requires both secrets with at least 32 bytes each.
JWT_SECRET=
IRIS_ADMIN_KEY=
DATABASE_PATH=
DATABASE_URL=
ALLOWED_ORIGINS=
GEMINI_API_KEY=
# Explicitly tested alternative for projects where 2.5 Flash returns 404.
GEMINI_MODEL=gemini-3.1-flash-lite
# One same-model retry for HTTP 429/503 only. Set 0 to disable retries.
GEMINI_MAX_RETRIES=1
TINYFISH_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
IRIS_DISABLE_SCHEDULER=0
