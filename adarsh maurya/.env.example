# Explicit deterministic demo. Choose live for genuine provider operations.
IRIS_MODE=demo
IRIS_ENV=development
# Development uses a persistent random key outside Git.
# Production requires both secrets with at least 32 bytes each.
JWT_SECRET=
IRIS_ADMIN_KEY=
DATABASE_PATH=
DATABASE_URL=
ALLOWED_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TINYFISH_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
IRIS_DISABLE_SCHEDULER=0
