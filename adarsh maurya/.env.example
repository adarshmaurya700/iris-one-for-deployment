# Optional. No keys are needed for the local cached catalog and deterministic assistant.
TINYFISH_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
# PostgreSQL/Supabase URL; omit for SQLite WAL. Startup connection failure falls back to SQLite.
DATABASE_URL=
# Optional SQLite override. Use a persistent volume path in deployment.
DATABASE_PATH=
# Set a strong random secret when deploying the existing authentication service.
JWT_SECRET=
